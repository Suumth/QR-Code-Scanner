{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker-tests.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "vitest/globals",
      "@cloudflare/vitest-pool-workers/types",
      "./worker-configuration.d.ts"
    ]
  },
  "include": ["worker/**/*.ts", "test/worker/**/*.ts"]
}
